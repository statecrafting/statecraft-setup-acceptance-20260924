  "id": "github-actions-rust",
  "identity": "e0732d4bf0db3b0181b42432d5a1fe4ad4745d90b55b4049c9acda5b70105126",
  "jobs": {
    "ai-review": {
      "optional": false,
      "pull_request": "required-review",
      "push": "inapplicable",
      "required": true
    },
    "code": {
      "optional": false,
      "pull_request": "required",
      "push": "required",
      "required": true
    },
    "governance": {
      "optional": false,
      "pull_request": "required",
      "push": "required",
      "required": true
    },
    "review-exception": {
      "optional": false,
      "pull_request": "rc-exception",
      "push": "inapplicable",
      "required": true
    }
  },
  "parameters": {
    "code_owners": [
      "@bartekus"
    ],
    "default_branch": "main",
    "diff_cap": 2000,
    "exclude": [
      ".statecraft/derived"
    ],
    "release_branch_pattern": "release/*"
  },
  "prerequisites": {
    "local": [
      "an exact spec-spine pin",
      "rust-toolchain.toml",
      "Cargo.lock",
      "a git work tree"
    ]
  },
  "remote": [
    "Settings, Actions: Actions enabled; the workflow token read-only by default",
    "the secret CLAUDE_CODE_OAUTH_TOKEN set by the operator (gh secret set CLAUDE_CODE_OAUTH_TOKEN); its value is never in a log, a file or a message",
    "branch protection on the default branch: require the status check ci-gate, and branches up to date",
    "branch protection on the default branch: require code-owner review, so a change to the profile's files needs a review its author cannot give (S-3)",
    "the Environment statecraft-review-exception with the owner as a required reviewer, for release-candidate exceptions (S-1)"
  ],
  "review": {
    "credential": "CLAUDE_CODE_OAUTH_TOKEN",
    "never_an_approval": true,
    "release_branch_pattern": "release/*",
    "release_candidate_rule": {
      "exception_environment": "statecraft-review-exception",
      "requires": "a review (findings or no-findings), or an owner exception"
    },
    "skip_classes": [
      "draft",
      "fork",
      "dependabot",
      "oversized",
      "transient"
    ],
    "tool": "claude-code",
    "tool_version": "2.1.116"
  },
  "revision": 1
}
